#!/usr/bin/env bash

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
	local tmpFile="${@%/}.tar";
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

	size=$(
		stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}" 2> /dev/null;  # GNU `stat`
	);

	local cmd="";
	if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
		# the .tar file is smaller than 50 MB and Zopfli is available; use it
		cmd="zopfli";
	else
		if hash pigz 2> /dev/null; then
			cmd="pigz";
		else
			cmd="gzip";
		fi;
	fi;

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…";
	"${cmd}" -v "${tmpFile}" || return 1;
	[ -f "${tmpFile}" ] && rm "${tmpFile}";

	zippedSize=$(
		stat -f"%z" "${tmpFile}.gz" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}.gz" 2> /dev/null; # GNU `stat`
	);

	echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully.";
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Use Git’s colored diff when available
hash git &>/dev/null;
if [ $? -eq 0 ]; then
	function diff() {
		git diff --no-index --color-words "$@";
	}
fi;

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
	local port="${1:-8000}";
	sleep 1 && open "http://localhost:${port}/" &
	# Set the default Content-Type to `text/plain` instead of `application/octet-stream`
	# And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
	python -c $'import SimpleHTTPServer;\nmap = SimpleHTTPServer.SimpleHTTPRequestHandler.extensions_map;\nmap[""] = "text/plain";\nfor key, value in map.items():\n\tmap[key] = value + ";charset=UTF-8";\nSimpleHTTPServer.test();' "$port";
}

# Start a PHP server from a directory, optionally specifying the port
# (Requires PHP 5.4.0+.)
function phpserver() {
	local port="${1:-4000}";
	local ip=$(ipconfig getifaddr en1);
	sleep 1 && open "http://${ip}:${port}/" &
	php -S "${ip}:${port}";
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c < "$1");
	local gzipsize=$(gzip -c "$1" | wc -c);
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# Run `dig` and display the most useful info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified.";
		return 1;
	fi;

	local domain="${1}";
	echo "Testing ${domain}…";
	echo ""; # newline

	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
		local certText=$(echo "${tmp}" \
			| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version");
		echo "Common Name:";
		echo ""; # newline
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
		echo ""; # newline
		echo "Subject Alternative Name(s):";
		echo ""; # newline
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
			| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
		return 0;
	else
		echo "ERROR: Certificate not found.";
		return 1;
	fi;
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make the `o` function (see below) cross-platform.
if [ ! $(uname -s) = 'Darwin' ]; then
	if grep -q Microsoft /proc/version; then
		# Ubuntu on Windows using the Linux subsystem
		alias open='explorer.exe';
	else
		alias open='xdg-open';
	fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# Manually remove a downloaded app or file from the quarantine
function unquarantine() {
	for attribute in com.apple.metadata:kMDItemDownloadedDate com.apple.metadata:kMDItemWhereFroms com.apple.quarantine; do
		xattr -r -d "$attribute" "$@"
	done
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}

# Run `terraform apply` for a workspace: `tfa [<workspace>] [<apply args>...]`.
# With a workspace, select it and use `terraform.<workspace>.tfvars`.
# Without a workspace, use the `default` workspace and no var file. This fails
# if the root has workspace tfvars files, to prevent an apply to the wrong
# workspace. The first argument is a workspace only if it does not start with
# `-`. All other arguments go to `terraform apply` (for example `-target=...`).
function tfa() {
	local workspace="default";
	if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
		workspace="$1";
		shift;
	fi;
	local varFileArgs=();
	if [ "$workspace" = "default" ]; then
		local workspaceVarFiles;
		workspaceVarFiles=$(find . -maxdepth 1 -name 'terraform.*.tfvars' | sort);
		if [ -n "$workspaceVarFiles" ]; then
			echo "usage: tfa <workspace> [<apply args>...]" >&2;
			echo "This root has workspace var files:" >&2;
			echo "$workspaceVarFiles" >&2;
			return 1;
		fi;
	else
		local varFile="terraform.${workspace}.tfvars";
		if [ ! -f "$varFile" ]; then
			echo "tfa: ${varFile} not found" >&2;
			return 1;
		fi;
		varFileArgs=("-var-file=${varFile}");
	fi;
	terraform init -lockfile=readonly \
		&& terraform workspace select "$workspace" \
		&& terraform apply "${varFileArgs[@]}" "$@";
}

# Run the `pi` coding agent inside a bubblewrap (bwrap) jail so it can only
# write to the working directory and its own ~/.pi state; the rest of the
# filesystem is mounted read-only and /tmp is a private tmpfs. Network is
# shared by default so pi can reach model providers. Requires an AppArmor
# profile granting unprivileged user namespaces to bwrap.
#
# Usage: bwpi [--ro|--rw] [--work <dir>] [--rw-path <dir>] [--no-net] [--] [<pi args>...]
#   --ro           mount the working directory read-only (default: writable)
#   --rw           mount the working directory read-write (default)
#   --work <dir>   use <dir> as the working directory (default: $PWD)
#   --rw-path <d>  additionally mount <dir> read-write
#   --no-net       run without network access
#
# npm/npx cache: MCP servers configured with `npx` (see ~/.pi/agent/mcp.json)
# need a *writable* npm cache, otherwise npm aborts while creating
# ~/.npm/_cacache/tmp with EROFS. Rather than mounting the host ~/.npm
# read-write -- which also holds _npx installs that later run unsandboxed, so
# a sandboxed process could plant code there -- npm is pointed at a
# sandbox-owned cache under ~/.pi. Use BWPI_NPM_CACHE="$HOME/.npm" together
# with `--rw-path "$HOME/.npm"` to share the host cache instead (faster,
# reuses tarballs already downloaded). Note that `--no-net` only works for
# packages already present in the cache, and that the sandbox has its own
# network namespace, so in-jail 127.0.0.1 is not the host's localhost.
#
#   BWPI_NPM_CACHE  npm cache directory handed to the sandbox
#
# NOTE: `--new-session` is intentionally omitted when the kernel already
# blocks TIOCSTI input injection. setsid() detaches the sandbox from the
# controlling terminal, so the pty's foreground process group (bwrap itself)
# receives SIGWINCH and the sandboxed child never does. Node only refreshes
# its tty dimensions from SIGWINCH, so pi (and vim, htop, ...) never learn the
# terminal was resized and the screen stops redrawing correctly.
#
# `--new-session` exists to stop a sandboxed process injecting keystrokes into
# your shell via the TIOCSTI ioctl (CVE-2017-5226). Linux 6.2 added the
# /proc/sys/dev/tty/legacy_tiocsti knob; when it reads 0 the kernel denies
# TIOCSTI to anything without CAP_SYS_ADMIN in the initial user namespace, so
# the flag buys nothing. Kernels/distros without that knob still get
# --new-session (safe, but no resize handling).
#   BWPI_NEW_SESSION=1  force --new-session on (pre-6.2 kernels)
#   BWPI_NEW_SESSION=0  force it off (resize works, TIOCSTI unprotected)
function bwpi() {
	if ! command -v bwrap > /dev/null 2>&1; then
		echo "bwpi: bwrap not found in PATH" >&2;
		return 1;
	fi;

	local piBin;
	piBin="$(command -v pi || echo "$HOME/bin/pi")";

	local npmCacheDir="${BWPI_NPM_CACHE:-$HOME/.pi/cache/npm}";
	mkdir -p "$npmCacheDir";

	local workspace="$PWD";
	local workMode="--bind";
	local netArgs=();
	local extraArgs=();
	local sessionArgs=();
	case "${BWPI_NEW_SESSION:-auto}" in
		0) ;;
		1) sessionArgs=(--new-session);;
		*)
			# No knob (kernel < 6.2) or TIOCSTI still permitted: stay safe.
			if [ "$(cat /proc/sys/dev/tty/legacy_tiocsti 2> /dev/null)" != "0" ]; then
				sessionArgs=(--new-session);
			fi;;
	esac;
	while [ $# -gt 0 ]; do
		case "$1" in
			--ro) workMode="--ro-bind"; shift;;
			--rw) workMode="--bind"; shift;;
			--work) workspace="$2"; shift 2;;
			--work=*) workspace="${1#--work=}"; shift;;
			--rw-path) extraArgs+=(--bind "$2" "$2"); shift 2;;
			--no-net) netArgs=(--unshare-net); shift;;
			--) shift; break;;
			*) break;;
		esac;
	done;

	# Not `exec`: exec would replace the interactive shell with bwrap, so the
	# terminal window/session dies along with pi. Running bwrap as a child lets
	# the shell reclaim the terminal and print a fresh prompt afterwards.
	bwrap \
		--ro-bind / / \
		--tmpfs /tmp \
		--dev /dev --proc /proc \
		--bind "$HOME/.pi" "$HOME/.pi" \
		"$workMode" "$workspace" "$workspace" \
		"${extraArgs[@]}" \
		--unshare-pid --unshare-ipc --unshare-uts \
		"${netArgs[@]}" \
		"${sessionArgs[@]}" --die-with-parent \
		--chdir "$workspace" \
		--setenv HOME "$HOME" \
		--setenv npm_config_cache "$npmCacheDir" \
		"$piBin" "$@";
}
