#!/bin/bash

# Bootstrap entrypoint. `./bun` is the bun-strap wrapper
# (https://github.com/murrayju/bun-strap) that downloads and runs a pinned bun
# without needing one installed globally. Bun installs the dependencies and
# runs the build targets, so there is no node/yarn vendoring here anymore.
#
#   ./bs              # default target (targets/bootstrap.ts)
#   ./bs apt          # any other file in targets/
#
# `./bun` caches its download under $(pwd)/download, so this script cds to the
# repository first (that also lets `./bs` be run from any directory).

set -euo pipefail

cd "$(dirname "$0")"

./bun install
exec ./bun ./targets/run.ts "$@"
