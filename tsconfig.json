{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_version": "26.0.0",

  "compilerOptions": {
    "lib": ["es2025", "ESNext.Collection", "ESNext.Temporal"],
    "module": "preserve",
    "target": "es2025",
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["targets/**/*.ts"]
}
